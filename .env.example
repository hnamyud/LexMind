# ===========================================================================
# SHARED CONFIG FOR backend-core + ai-service
# Copy this file to .env before running docker compose.
# ===========================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Internal auth secret
# backend-core reads: INTERNAL_SECRET
# ai-service reads: INTERNAL_SECRET
# ---------------------------------------------------------------------------
INTERNAL_SECRET=change-me

# ---------------------------------------------------------------------------
# Infrastructure defaults for docker-compose
# ---------------------------------------------------------------------------
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot_law
NEO4J_PASSWORD=neo4jpassword

# ---------------------------------------------------------------------------
# backend-core (NestJS)
# ---------------------------------------------------------------------------
PORT=8080
FE_DOMAIN=http://localhost:5173

# JWT (required)
JWT_ACCESS_SECRET=replace-access-secret
JWT_ACCESS_EXPIRED=1d
JWT_REFRESH_SECRET=replace-refresh-secret
JWT_REFRESH_EXPIRED=15d

# Local/dev fallback values. In docker-compose, DATABASE_URL is overridden.
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot_law

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# OAuth2 Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
BROWSER_REDIRECT_URI=http://localhost:5173?token=

# Mail (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PREVIEW=false
MAIL_FROM="Support Team <no-reply@domain.com>"

# ---------------------------------------------------------------------------
# ai-service routing
# ---------------------------------------------------------------------------
FASTAPI_URL=http://localhost:8001
FASTAPI_URI=127.0.0.1
FASTAPI_PORT=8001
LEXMIND_AI_SERVICE_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# ai-service model/provider
# Current code path supports OpenAI-compatible proxy via LOCAL_API_KEY+BASE_URL
# ---------------------------------------------------------------------------
LOCAL_API_KEY=
BASE_URL=

# Optional Google provider path
GOOGLE_API_KEY=

# LLM model ids
LLM_ROUTER=
LLM_DIRECT=
LLM_REFLECTOR=
LLM_GENERATOR=
LLM_GENERATOR_L1=
LLM_GENERATOR_L2=
LLM_GENERATOR_L3=

# Embedding model (required for retriever)
EMBED_MODEL_ID=

# Neo4j (local/dev fallback; docker-compose overrides host)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Web search keys (optional)
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# LangSmith / LangChain tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chatbot-law
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com